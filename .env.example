# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=false

# Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# TurboSMTP / SMTP
SMTP_HOST=smtp.turbosmtp.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Registration / OTP
AUTH_REGISTRATION_EMAIL_CONFIRMATION_REQUIRED=true
AUTH_REGISTRATION_OTP_TTL_SECONDS=600
AUTH_REGISTRATION_OTP_LENGTH=6
AUTH_REGISTRATION_OTP_MAX_ATTEMPTS=5
AUTH_REGISTRATION_OTP_RESEND_SECONDS=60

# JWT
JWT_SECRET=super_secret_access_key_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_me
JWT_REFRESH_EXPIRES_IN=30d

# Auth cookies (HttpOnly access_token / refresh_token)
# SameSite=lax is default. Cross-origin SPAs (other localhost ports) need none + Secure (HTTPS).
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=

AUTH_EMAIL_CHANGE_OTP_TTL_SECONDS=600
AUTH_EMAIL_CHANGE_OTP_LENGTH=6
AUTH_EMAIL_CHANGE_OTP_MAX_ATTEMPTS=5
AUTH_EMAIL_CHANGE_OTP_RESEND_SECONDS=60

AUTH_ACCOUNT_DELETION_OTP_TTL_SECONDS=600
AUTH_ACCOUNT_DELETION_OTP_LENGTH=6
AUTH_ACCOUNT_DELETION_OTP_MAX_ATTEMPTS=5
AUTH_ACCOUNT_DELETION_OTP_RESEND_SECONDS=60